generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid())
  firebaseUid String     @unique
  bookmarks   Bookmark[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Bookmark {
  id                 String    @id @default(cuid())
  firebaseUid        String
  url                String
  title              String?
  site               String
  slug               String
  comicProfilePic    String?
  lastChapter        Float?
  lastCheckedAt      DateTime?
  newChapterIsLocked Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([firebaseUid, url])
  @@index([firebaseUid])
}
